# Hexadezimales Zufallspasswort mit mindestens 32 Zeichen einsetzen.
ODENTALER_DB_PASSWORD=
ODENTALER_ENV=production
ODENTALER_HOST=cashless.local
# Nur für ausdrücklich gewollten LAN-Betrieb auf die lokale Server-IP setzen.
ODENTALER_BIND_ADDRESS=127.0.0.1
ODENTALER_TLS_PORT=443
# Optionaler Browser-Admin. Exakte HTTPS-Adresse ohne /admin oder abschließenden Schrägstrich.
ODENTALER_WEB_ADMIN_ORIGIN=
# Eigenes zufälliges Passwort mit mindestens 16 Zeichen. Beispiel für die Erzeugung: openssl rand -hex 24
ODENTALER_WEB_ADMIN_PASSWORD=
