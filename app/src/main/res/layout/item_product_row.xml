<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/productRowRoot"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginTop="8dp"
    android:gravity="center_vertical"
    android:background="@drawable/odentaler_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Name + price -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_weight="1"
        android:layout_width="0dp"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txtProductName"
            android:text="Produktname"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- e.g. "Preis: 2.0 T" -->
        <TextView
            android:id="@+id/txtProductPrice"
            android:text="Preis: - T"
            android:textSize="18sp"
            android:layout_marginTop="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Quantity control -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMinus"
            android:contentDescription="@string/operation_quantity_decrease"
            android:text="−"
            android:textSize="20sp"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/txtQty"
            android:text="0"
            android:textSize="20sp"
            android:gravity="center"
            android:minWidth="36dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlus"
            android:contentDescription="@string/operation_quantity_increase"
            android:text="+"
            android:textSize="20sp"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />
    </LinearLayout>

</LinearLayout>
